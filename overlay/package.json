    "ajv": "^8.20.0",
    "dotenv": "^18.0.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "webgazer": "^3.5.3",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "agentation": "3.1.2",
    "electron": "^45.0.0",
    "electron-vite": "^6.0.0",
    "jsdom": "^30.1.3",
    "json-schema-to-typescript": "^16.0.0",
