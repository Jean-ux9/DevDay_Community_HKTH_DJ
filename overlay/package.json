{
  "name": "overlay",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "node scripts/ensure-electron.mjs && node scripts/prepare-gaze-assets.mjs && electron-vite dev",
    "build": "node scripts/ensure-electron.mjs && node scripts/prepare-gaze-assets.mjs && electron-vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
